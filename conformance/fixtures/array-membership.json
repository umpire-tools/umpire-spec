{
  "id": "array-membership",
  "fixtureVersion": 1,
  "description": "contains finds one primitive in an array-valued field with JSON equality and no type coercion; in and notIn never look inside an array value.",
  "schema": {
    "version": 1,
    "fields": {
      "benchBats": {
        "isEmpty": "array"
      },
      "jerseyNumbers": {
        "isEmpty": "array"
      },
      "scoutTags": {},
      "sotoGate": {},
      "noVolpeGate": {},
      "numberGate": {},
      "scoutContainsGate": {},
      "scoutInGate": {},
      "scoutNotInGate": {},
      "pinchHitter": {}
    },
    "rules": [
      {
        "type": "enabledWhen",
        "field": "sotoGate",
        "when": {
          "op": "contains",
          "field": "benchBats",
          "value": "Soto"
        },
        "reason": "Soto must be on the bench"
      },
      {
        "type": "enabledWhen",
        "field": "noVolpeGate",
        "when": {
          "op": "not",
          "expr": {
            "op": "contains",
            "field": "benchBats",
            "value": "Volpe"
          }
        },
        "reason": "Volpe is already committed"
      },
      {
        "type": "enabledWhen",
        "field": "numberGate",
        "when": {
          "op": "contains",
          "field": "jerseyNumbers",
          "value": 22
        },
        "reason": "Number 22 must be dressed"
      },
      {
        "type": "enabledWhen",
        "field": "scoutContainsGate",
        "when": {
          "op": "contains",
          "field": "scoutTags",
          "value": "lefty"
        },
        "reason": "Scouts must tag a lefty"
      },
      {
        "type": "enabledWhen",
        "field": "scoutInGate",
        "when": {
          "op": "in",
          "field": "scoutTags",
          "values": [
            "lefty"
          ]
        },
        "reason": "Scout tag must be lefty"
      },
      {
        "type": "enabledWhen",
        "field": "scoutNotInGate",
        "when": {
          "op": "notIn",
          "field": "scoutTags",
          "values": [
            "lefty"
          ]
        },
        "reason": "Scout tag cannot be lefty"
      },
      {
        "type": "requires",
        "field": "pinchHitter",
        "dependencies": [
          {
            "op": "contains",
            "field": "benchBats",
            "value": "Judge"
          }
        ],
        "reason": "Judge must be available to pinch hit"
      }
    ]
  },
